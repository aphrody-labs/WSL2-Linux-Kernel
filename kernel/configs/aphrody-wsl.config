# SPDX-License-Identifier: GPL-2.0-only
# WSL GPU-PV uses dxgkrnl and the Windows driver, not native NVIDIA PCI modules.
CONFIG_LOCALVERSION="-aphrody-wsl2"
CONFIG_CONFIGFS_FS=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VMBUS=y
CONFIG_DXGKRNL=y
CONFIG_PCI_HYPERV=y
CONFIG_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_FUSE_FS=y
CONFIG_SWIOTLB=y
# CONFIG_NOVA_CORE is not set
# CONFIG_DRM_NOVA is not set
# CONFIG_DRM_NOUVEAU is not set
# CONFIG_APHRODY_NVIDIA_HMM is not set
