# Aphrody WSL2 kernel fragment, merged last on top of Microsoft/config-wsl, then the Aphrody
# Alpine fragments (aports aphrody/linux-aphrody/config-aphrody.fragment and bun.config).
# Only options specific to the WSL2 guest; everything else comes from those files.

# ---- Bun ------------------------------------------------------------------------------------
# /dev/bun_accel (drivers/misc/bun_accel.rs): batched copies for bun install. Built in because
# WSL loads modules only from the kernelModules VHD; built in, it works with kernel= alone.
CONFIG_BUN_ACCEL=y

# ---- WSL2 guest (Hyper-V) -------------------------------------------------------------------
# GPU paravirtualisation: /dev/dxg for Mesa d3d12/dozen and CUDA (WSLg, wgpu, WebKit).
CONFIG_DXGKRNL=y
CONFIG_HYPERV=y
CONFIG_HYPERV_VSOCKETS=y
CONFIG_HYPERV_STORAGE=y
CONFIG_HYPERV_NET=y
CONFIG_HYPERV_BALLOON=y
CONFIG_HYPERV_UTILS=y
CONFIG_PCI_HYPERV=y
CONFIG_HID_HYPERV_MOUSE=y
CONFIG_HYPERV_KEYBOARD=y
# Hyper-V synthetic framebuffer DRM (fallback display, WSLg uses RDP).
CONFIG_DRM_HYPERV=y
# 9p over virtio/vsock: drvfs (/mnt/c) and \\wsl$ access.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_9P_FS_POSIX_ACL=y
# virtiofs: faster Windows file sharing when WSL uses it.
CONFIG_VIRTIO_FS=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_DAX=y
CONFIG_VIRTIO_PMEM=y
CONFIG_FS_DAX=y
# Docker / Bun containers inside the distro.
CONFIG_OVERLAY_FS=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y

# ---- memory: WSL autoMemoryReclaim and sparse VHD ------------------------------------------
# zram swap device for the guest (WSL swap= is a VHD on the host disk).
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# DAMON-based reclaim: returns cold pages to the host between bun builds.
CONFIG_DAMON=y
CONFIG_DAMON_PADDR=y
CONFIG_DAMON_RECLAIM=y
# Free page reporting: freed guest memory goes back to Windows (balloon).
CONFIG_PAGE_REPORTING=y
# Pressure stall information: memory/cpu/io pressure for tuning and earlyoom.
CONFIG_PSI=y

# ---- tracing and BPF ------------------------------------------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_LSM=y

# ---- WSL boots without an initramfs ------------------------------------------------------
CONFIG_EXT4_FS=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
